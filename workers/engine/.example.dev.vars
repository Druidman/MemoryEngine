# cp .example.dev.vars .dev.vars

# SUPABASE SETUP
SUPABASE_URL='your <SUPABASE_URL>'
SUPABASE_PUBLIC_KEY='your <SUPABASE_PUBLIC_KEY>'
## Needed for service client operations (currently none)
SUPABASE_SECRET_KEY='your <SUPABASE_SECRET_KEY>'

# OpenRouter
OPENROUTER_API_KEY='your <OPENROUTER_API_KEY>'

## I recommend these models, as they are cheap and offer good reliability
ENTITY_EXTRACTION_MODEL='deepseek/deepseek-v4-flash-0731'
MEMORY_EXTRACTION_MODEL='deepseek/deepseek-v4-flash-0731'
CHAT_MODEL='deepseek/deepseek-v4-flash-0731'
EMBEDDING_MODEL='qwen/qwen3-embedding-8b'

## Dims that embedder is supposed to use. Keep in mind that it requires db compatibility that is why I mark 
## it as 
## ! FRAGILE !
EMBEDDING_MODEL_DIMS=1024